extend layout

block content
  //- https://codepen.io/gmanikandan-dev/details/NWOaajb
  .row.justify-content-center.align-items-center: .col-lg-6.col-md-9.col-sm-12
    .card.bg-light.shadow: .card-body
      form(method="post")
        .input-group.mb-3
          span.input-group-text.fs-2.bi.bi-person
          .form-floating
            input.form-control(type="text" autofocus=!u required name="u" placeholder='' value=u)
            label Учётная запись
        .input-group.mb-3
          span.input-group-text.fs-2.bi.bi-key
          .form-floating
            input.form-control(type="password" required autofocus=!!u name="p" placeholder='')
            label Пароль
        .d-grid.col-6.mx-auto
          button.btn.btn-primary.btn-default(type="submit")
            i.bi.bi-box-arrow-in-right
            |
            | Авторизация!
        span= err
